---
import { Image } from 'astro:assets';
import { resources } from '../data/content';
---

<section class="section resources" id="recursos" data-resources>
  <div class="container">
    <header class="resources__head">
      <span class="eyebrow" data-reveal="up">Recursos gratuitos</span>
      <h2 class="h-lg" data-split>Materiales para tu <em class="italic gold-text">aula</em></h2>
    </header>

    <ul class="resources__list">
      {
        resources.map((r, i) => (
          <li data-reveal="up">
            <a href="#contacto" class="res" data-res-index={i} data-cursor="Abrir">
              <span class="res__n">0{i + 1}</span>
              <span class="res__title">{r.title}</span>
              <span class="res__type">{r.type}</span>
              <span class="res__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="res-preview" aria-hidden="true" data-res-preview>
    <div class="res-preview__inner" data-res-preview-inner>
      {
        resources.map((r) => (
          <div class="res-preview__img">
            <Image src={r.img} alt="" widths={[400]} sizes="320px" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .resources__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .resources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(201, 162, 74, 0.2);
  }

  .res {
    position: relative;
    display: grid;
    grid-template-columns: 60px 1fr auto 56px;
    align-items: center;
    gap: 24px;
    padding-block: clamp(24px, 3vw, 40px);
    border-bottom: 1px solid rgba(201, 162, 74, 0.2);
    overflow: hidden;
    isolation: isolate;
  }

  .res::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(201, 162, 74, 0.14), transparent 80%);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease);
  }

  .res:hover::before {
    transform: scaleY(1);
  }

  .res__n {
    color: var(--gold);
    font-size: 14px;
  }

  .res__title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 44px);
    line-height: 1.1;
    transition: transform 0.5s var(--ease);
  }

  .res:hover .res__title {
    transform: translateX(16px);
  }

  .res__type {
    color: var(--grey);
    font-size: 14px;
  }

  .res__arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--gold);
    transition:
      background-color 0.4s,
      color 0.4s;
  }

  .res:hover .res__arrow {
    background: var(--gold);
    color: var(--black);
  }

  .res__arrow svg {
    width: 16px;
  }

  .res-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 320px;
    height: 220px;
    border-radius: var(--radius);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6);
  }

  .res-preview__inner {
    width: 100%;
    height: 100%;
  }

  .res-preview__img {
    width: 100%;
    height: 100%;
  }

  .res-preview__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .res {
      grid-template-columns: 1fr 52px;
      gap: 8px 16px;
    }

    .res__n {
      display: none;
    }

    .res__type {
      grid-row: 2;
    }

    .res__arrow {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }

  @media (hover: none) {
    .res-preview {
      display: none;
    }
  }
</style>

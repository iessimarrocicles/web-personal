---
import { Image } from 'astro:assets';
import { images, site } from '../data/content';
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__orb"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__top">
      <span class="eyebrow hero__fade">{site.role}</span>
      <span class="hero__fade hero__loc">{site.location}</span>
    </div>

    <h1 class="hero__title h-xl">
      <span class="hero__line"><span class="hero__word">Enseñar</span></span>
      <span class="hero__line hero__line--indent"><span class="hero__word italic gold-text">es encender</span></span>
      <span class="hero__line"><span class="hero__word">curiosidad</span><span class="hero__dot gold-text">.</span></span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__media media" data-hero-media>
        <Image src={images.hero} alt="Docente con los brazos cruzados en un aula iluminada con luz dorada" loading="eager" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 55vw" />
      </div>

      <div class="hero__aside">
        <p class="lead hero__fade">
          Formación para docentes que quieren innovar con sentido: inteligencia artificial, competencia digital y
          metodologías activas, aplicadas al aula real.
        </p>
        <div class="hero__ctas hero__fade">
          <a href="#cursos" class="btn btn--gold" data-magnetic>
            Ver cursos
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
          <a href="#sobre-mi" class="btn btn--outline" data-magnetic>Conóceme</a>
        </div>
      </div>
    </div>
  </div>

  <a href="#sobre-mi" class="hero__badge" aria-label="Bajar a la siguiente sección" data-cursor="Bajar">
    <svg viewBox="0 0 200 200" class="hero__badge-text" aria-hidden="true">
      <defs><path id="circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
      <text><textPath href="#circle">Aprender · Enseñar · Inspirar · Transformar · </textPath></text>
    </svg>
    <svg viewBox="0 0 24 24" class="hero__badge-arrow" aria-hidden="true"><path d="M12 4v16M5 13l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: clamp(120px, 14vh, 160px);
    padding-bottom: 64px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__orb {
    position: absolute;
    width: 70vw;
    height: 70vw;
    max-width: 1000px;
    max-height: 1000px;
    right: -20vw;
    top: -25vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 162, 74, 0.22), transparent 62%);
    filter: blur(20px);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 162, 74, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 162, 74, 0.06) 1px, transparent 1px);
    background-size: 96px 96px;
    mask-image: radial-gradient(ellipse at 50% 30%, black, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black, transparent 75%);
  }

  .hero__inner {
    position: relative;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(24px, 4vw, 48px);
    font-size: 13px;
    color: var(--grey);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-weight: 300;
    line-height: 0.95;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
  }

  .hero__word {
    display: inline-block;
  }

  .hero__line--indent {
    padding-left: clamp(40px, 12vw, 240px);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    margin-top: clamp(40px, 6vw, 80px);
  }

  .hero__media {
    aspect-ratio: 16 / 9;
  }

  .hero__media :global(img) {
    transform: scale(1.15);
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__badge {
    position: absolute;
    right: var(--gutter);
    top: 46%;
    width: 140px;
    height: 140px;
    display: grid;
    place-items: center;
    color: var(--gold);
  }

  .hero__badge-text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: var(--white);
  }

  .hero__badge-arrow {
    width: 28px;
  }

  @media (max-width: 900px) {
    .hero__bottom {
      grid-template-columns: 1fr;
    }

    .hero__badge {
      display: none;
    }

    .hero__loc {
      display: none;
    }
  }
</style>

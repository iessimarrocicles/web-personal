---
import { nav, site } from '../data/content';
---

<header class="header" data-header>
  <div class="header__inner container">
    <a href="#top" class="logo" aria-label={`${site.name}, inicio`}>
      <span class="logo__mark">
        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M14 26 L32 17 L50 26 L32 35Z" fill="currentColor"></path><path d="M21 30 V40 C21 44 43 44 43 40 V30" fill="none" stroke="currentColor" stroke-width="3"></path></svg>
      </span>
      <span class="logo__text">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} class="nav__link">
            <span data-text={item.label}>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <a href="#contacto" class="btn btn--outline header__cta" data-magnetic>Reserva una formación</a>

    <button class="burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" data-menu aria-hidden="true">
  <nav class="mobile-menu__nav" aria-label="Móvil">
    {
      nav.map((item, i) => (
        <a href={item.href} class="mobile-menu__link" data-menu-link>
          <small>0{i + 1}</small>
          {item.label}
        </a>
      ))
    }
  </nav>
  <p class="mobile-menu__foot">{site.email}</p>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding-block: 18px;
    transition:
      transform 0.6s var(--ease),
      background-color 0.4s,
      backdrop-filter 0.4s;
  }

  :global(.header.is-scrolled) {
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(201, 162, 74, 0.12);
  }

  :global(.header.is-hidden) {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-serif);
    font-size: 22px;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--gold);
  }

  .logo__mark svg {
    width: 24px;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav__link {
    position: relative;
    overflow: hidden;
    display: block;
    font-size: 14px;
    height: 1.6em;
  }

  .nav__link span {
    display: block;
    transition: transform 0.5s var(--ease);
  }

  .nav__link span::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--gold);
  }

  .nav__link:hover span {
    transform: translateY(-100%);
  }

  .header__cta {
    padding: 12px 22px;
    font-size: 14px;
  }

  .burger {
    display: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    position: relative;
    z-index: 120;
  }

  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--white);
    transition: transform 0.5s var(--ease);
  }

  .burger span:first-child {
    top: 20px;
  }

  .burger span:last-child {
    top: 27px;
  }

  :global(.burger[aria-expanded='true']) span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  :global(.burger[aria-expanded='true']) span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px var(--gutter) 48px;
    background: var(--ink);
    clip-path: circle(0% at calc(100% - 40px) 40px);
    visibility: hidden;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-menu__link {
    font-family: var(--font-serif);
    font-size: clamp(40px, 11vw, 72px);
    line-height: 1.1;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .mobile-menu__link small {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--gold);
  }

  .mobile-menu__foot {
    margin-top: auto;
    color: var(--grey);
  }

  @media (max-width: 960px) {
    .nav,
    .header__cta {
      display: none;
    }

    .burger {
      display: block;
    }
  }
</style>

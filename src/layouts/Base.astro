---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '../data/content';

interface Props {
  title?: string;
}

const { title = `${site.name} — ${site.role}` } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body class="is-loading">
    <Preloader />
    <Cursor />
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
